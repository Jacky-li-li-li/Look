{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": "off",
			"correctness": {
				"useJsxKeyInIterable": "off",
				"noUnusedFunctionParameters": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off",
				"noParameterAssign": "off",
				"useImportType": "warn"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off",
				"noArrayIndexKey": "off",
				"noAssignInExpressions": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"apps/electron/src/**/*.ts",
			"apps/electron/src/**/*.tsx",
			"apps/electron/src/**/*.css",
			"apps/electron/src/**/*.html",
			"apps/electron/src/**/*.d.ts",
			"apps/electron/src/main/preload.cts",
			"apps/electron/test/**/*.ts",
			"apps/electron/test/**/*.tsx",
			"apps/electron/scripts/**/*.mjs",
			"apps/electron/vite.config.ts",
			"apps/electron/vitest.config.ts",
			"packages/*/src/**/*.ts",
			"packages/*/src/**/*.tsx",
			"packages/*/test/**/*.ts",
			"packages/*/vitest.config.ts"
		],
		"ignoreUnknown": true
	}
}
