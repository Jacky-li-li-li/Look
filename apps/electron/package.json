{
  "name": "@look/electron",
  "version": "2.3.5",
  "description": "Electron desktop agent app — Look",
  "private": true,
  "type": "module",
  "main": "dist/src/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "copy-file-icons": "node scripts/copy-file-icons.mjs",
    "dev:renderer": "vite",
    "dev:main": "npm run build:shared && npm run build:ui && npm run build:main && electron dist/src/main/index.js",
    "build:shared": "npm run build --workspace=@look/shared",
    "build:ui": "npm run build --workspace=@look/ui",
    "build:main": "rm -rf dist && tsc -p tsconfig.main.json && mkdir -p dist/src/main/assets && cp -f assets/icon-1024.png dist/src/main/assets/icon-1024.png",
    "build:renderer": "vite build",
    "start": "electron dist/src/main/index.js",
    "package": "npm run build && electron-builder --mac --publish never",
    "test": "vitest --run",
    "test:quick": "vitest --run --changed",
    "test:coverage": "vitest --run --coverage",
    "test:e2e:llm": "LOOK_E2E_LLM=1 vitest --run subagent-e2e-llm subagent-toggle-e2e-llm --reporter=verbose",
    "test:watch": "vitest",
    "build": "npm run build:main && npm run build:renderer",
    "lint": "biome check src test",
    "lint:fix": "biome check --write --unsafe src test",
    "format": "biome format --write src test",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@look/shared": "*",
    "@look/ui": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nut-tree/nut-js": "^3.1.2",
    "@pierre/diffs": "^1.3.2",
    "@pierre/theme": "^2.0.0",
    "@puppeteer/browsers": "^2.13.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/supabase-js": "^2.108.0",
    "@tailwindcss/vite": "^4.3.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.1",
    "jotai": "^2.20.0",
    "jotai-family": "^1.0.2",
    "lucide-react": "^1.17.0",
    "node-cron": "^4.6.0",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-virtuoso": "^4.18.7",
    "recharts": "^3.9.2",
    "shiki": "^3.23.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "thinking-orbs": "^0.2.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.0.0",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "material-icon-theme": "^5.36.1",
    "react-scan": "^1.2.0",
    "shadcn": "^4.10.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
