{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": ["packages/shared/src/*"],
      "@look/shared/*": ["packages/shared/src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "packages/shared/**/*.ts", "packages/shared/**/*.tsx"],
  "exclude": ["node_modules", "dist", "packages/shared/dist"]
}
