{
  "repository": {
    "name": "pi",
    "full_name": "earendil-works/pi",
    "type": "monorepo",
    "license": "MIT",
    "website": "https://pi.dev",
    "description": "A minimal terminal coding agent harness — extensible CLI coding agent with TypeScript extensions, skills, prompt templates, and themes."
  },
  "packages": {
    "coding-agent": {
      "name": "@earendil-works/pi-coding-agent",
      "version": "0.78.0",
      "description": "Coding agent CLI with read, bash, edit, write tools and session management",
      "npm_scope": "@earendil-works",
      "author": "Mario Zechner",
      "license": "MIT",
      "engines": { "node": ">=22.19.0" },
      "binary": "pi",
      "entry_point": "dist/cli.js"
    },
    "ai": { "name": "@earendil-works/pi-ai", "description": "Unified multi-provider LLM API (OpenAI, Anthropic, Google, etc.)" },
    "agent": { "name": "@earendil-works/pi-agent-core", "description": "Agent runtime with tool calling and state management" },
    "tui": { "name": "@earendil-works/pi-tui", "description": "Terminal UI library with differential rendering" }
  },
  "coding_agent_structure": {
    "root_files": [
      ".gitignore",
      "CHANGELOG.md (399KB)",
      "README.md (27.8KB)",
      "npm-shrinkwrap.json (60.7KB)",
      "package.json",
      "tsconfig.build.json",
      "tsconfig.examples.json",
      "vitest.config.ts"
    ],
    "src": {
      "cli_entries": ["cli.ts", "index.ts", "main.ts", "config.ts", "migrations.ts", "package-manager-cli.ts"],
      "cli": ["args.ts", "config-selector.ts", "file-processor.ts", "initial-message.ts", "list-models.ts", "session-picker.ts"],
      "core": {
        "session": [
          "agent-session.ts (104KB - main session logic)",
          "agent-session-runtime.ts (14KB)",
          "agent-session-services.ts (7KB)",
          "session-manager.ts (48KB)",
          "session-cwd.ts"
        ],
        "auth": ["auth-storage.ts (14KB)", "auth-guidance.ts", "provider-attribution.ts"],
        "models": ["model-registry.ts (36KB)", "model-resolver.ts (21KB)", "provider-display-names.ts"],
        "compaction": ["compaction/ (directory)"],
        "extensions": ["extensions/ (directory - extension system)"],
        "tools": ["tools/ (directory - built-in tools: read, write, edit, bash, grep, find, ls)"],
        "other_core": [
          "sdk.ts (14KB - programmatic API)",
          "package-manager.ts (78KB - pi package management)",
          "resource-loader.ts (32KB)",
          "settings-manager.ts (35KB)",
          "skills.ts (14KB)",
          "system-prompt.ts (6KB)",
          "keybindings.ts (11KB)",
          "messages.ts",
          "event-bus.ts",
          "bash-executor.ts",
          "export-html/ (directory)",
          "slash-commands.ts",
          "defaults.ts",
          "diagnostics.ts",
          "exec.ts",
          "footer-data-provider.ts",
          "http-dispatcher.ts",
          "output-guard.ts",
          "prompt-templates.ts",
          "resolve-config-value.ts",
          "source-info.ts",
          "telemetry.ts",
          "timings.ts"
        ]
      },
      "modes": {
        "index.ts": "mode exports",
        "interactive/": "Full TUI interactive mode with components, theme, etc.",
        "print-mode.ts": "Non-interactive print mode",
        "rpc/": "JSON-RPC mode for process integration"
      },
      "utils": {
        "files": [
          "ansi.ts", "changelog.ts", "child-process.ts", "clipboard.ts",
          "clipboard-image.ts", "clipboard-native.ts", "deprecation.ts",
          "exif-orientation.ts", "frontmatter.ts", "fs-watch.ts", "git.ts",
          "html.ts", "image-convert.ts", "image-resize.ts", "image-resize-core.ts",
          "image-resize-worker.ts", "json.ts", "mime.ts", "paths.ts",
          "photon.ts", "pi-user-agent.ts", "shell.ts", "sleep.ts",
          "syntax-highlight.ts", "tools-manager.ts", "version-check.ts",
          "windows-self-update.ts"
        ]
      },
      "bun": ["Bun-specific build files"]
    },
    "docs": {
      "pages": [
        "compaction.md", "custom-provider.md", "development.md", "docs.json",
        "extensions.md (100KB)", "index.md", "json.md", "keybindings.md",
        "models.md", "packages.md", "prompt-templates.md", "providers.md",
        "quickstart.md", "rpc.md (36KB)", "sdk.md (34KB)", "session-format.md",
        "sessions.md", "settings.md", "shell-aliases.md", "skills.md",
        "terminal-setup.md", "termux.md", "themes.md", "tmux.md",
        "tui.md (30KB)", "usage.md", "windows.md"
      ]
    },
    "examples": {
      "readme": true,
      "extensions": "Extension examples (including custom providers, sandbox, etc.)",
      "sdk": "SDK usage examples",
      "rpc-extension-ui.ts": "RPC extension UI example"
    },
    "scripts": ["migrate-sessions.sh"],
    "test": {
      "test_files": 45,
      "includes": ["rpc tests", "sdk tests", "session tests", "theme tests", "tools tests", "skills tests", "settings tests", "integration tests", "test harness"]
    }
  },
  "dependencies": {
    "runtime": [
      "@earendil-works/pi-agent-core ^0.78.0",
      "@earendil-works/pi-ai ^0.78.0",
      "@earendil-works/pi-tui ^0.78.0",
      "@silvia-odwyer/photon-node 0.3.4 (image processing)",
      "chalk 5.6.2 (terminal colors)",
      "cross-spawn 7.0.6 (cross-platform spawn)",
      "diff 8.0.4 (text diffing)",
      "glob 13.0.6 (file globbing)",
      "highlight.js 10.7.3 (syntax highlighting)",
      "hosted-git-info 9.0.3 (git host info)",
      "ignore 7.0.5 (gitignore matching)",
      "jiti 2.7.0 (runtime TypeScript)",
      "minimatch 10.2.5 (glob matching)",
      "proper-lockfile 4.1.2 (file locking)",
      "typebox 1.1.38 (JSON schema validation)",
      "undici 8.3.0 (HTTP client)",
      "yaml 2.9.0 (YAML parsing)"
    ],
    "optional": ["@mariozechner/clipboard 0.3.9"],
    "devDependencies": ["shx", "typescript 5.9.3", "vitest 3.2.4", "@types packages"]
  },
  "providers_supported": [
    "Anthropic (Claude)", "OpenAI (GPT, Codex)", "Google Gemini", "Google Vertex",
    "Amazon Bedrock", "Mistral", "Groq", "Cerebras", "DeepSeek",
    "xAI", "OpenRouter", "GitHub Copilot", "Azure OpenAI",
    "Cloudflare AI Gateway", "Cloudflare Workers AI", "Fireworks",
    "Together AI", "NVIDIA NIM", "Kimi For Coding", "MiniMax",
    "Xiaomi MiMo", "Vercel AI Gateway", "ZAI", "OpenCode Zen/Go",
    "Hugging Face", "Ant Ling"
  ],
  "key_features": [
    "Four modes: interactive (TUI), print, JSON, RPC (stdin/stdout JSONL)",
    "Seven built-in tools: read, write, edit, bash, grep, find, ls",
    "Tree-structured sessions with branching (/tree, /fork, /clone)",
    "Automatic and manual context compaction",
    "TypeScript extension system (custom tools, commands, UI, providers)",
    "Agent Skills standard (SKILL.md)",
    "Prompt templates with variable expansion",
    "Customizable themes (hot-reload)",
    "Pi Packages (shareable via npm/git)",
    "SDK for programmatic embedding",
    "25+ LLM providers supported",
    "OAuth and API key authentication",
    "Image paste/drag support",
    "File @-mention and path completion",
    "Configurable thinking levels",
    "Session export to HTML"
  ],
  "philosophy": {
    "no_mcp": "Build CLI tools with READMEs (Skills), or build MCP as extension",
    "no_sub_agents": "Use tmux or build via extensions",
    "no_permission_popups": "Run in container or build via extensions",
    "no_plan_mode": "Write plans to files or build via extensions",
    "no_builtin_todos": "Use TODO.md files",
    "no_background_bash": "Use tmux"
  }
}