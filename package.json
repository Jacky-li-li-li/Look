{
  "name": "look",
  "version": "0.0.0-workspace",
  "description": "Electron desktop agent app — Look",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "npx simple-git-hooks && npm run copy-file-icons --workspace=@look/electron && node scripts/patch-stick-to-bottom.mjs",
    "patch:vendor": "node scripts/patch-stick-to-bottom.mjs",
    "dev": "npm run dev --workspace=@look/electron",
    "copy-file-icons": "npm run copy-file-icons --workspace=@look/electron",
    "dev:renderer": "npm run dev:renderer --workspace=@look/electron",
    "dev:main": "npm run dev:main --workspace=@look/electron",
    "build": "npm run build --workspace=@look/shared && npm run build --workspace=@look/ui && npm run build --workspace=@look/electron",
    "build:shared": "npm run build --workspace=@look/shared",
    "build:main": "npm run build:main --workspace=@look/electron",
    "build:renderer": "npm run build:renderer --workspace=@look/electron",
    "start": "npm run start --workspace=@look/electron",
    "package": "npm run build && npm run package --workspace=@look/electron",
    "test": "npm test --workspaces --if-present",
    "test:quick": "npm run test:quick --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=@look/electron",
    "lint": "biome check apps/electron/src apps/electron/test packages",
    "lint:fix": "biome check --write --unsafe apps/electron/src apps/electron/test packages",
    "format": "biome format --write apps/electron/src apps/electron/test packages",
    "check:circular": "npx --yes madge@8 --circular --extensions ts,tsx --ts-config apps/electron/tsconfig.json apps/electron/src packages/shared/src",
    "check": "npm run lint && npm run typecheck --workspace=@look/shared && npm run build:shared && npm run typecheck --workspace=@look/electron && npm test"
  },
  "simple-git-hooks": {
    "pre-commit": "npx biome check --no-errors-on-unmatched --files-ignore-unknown=true --staged"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.13.1"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0"
  },
  "optionalDependencies": {
    "@pierre/theme": "1.1.0"
  }
}
