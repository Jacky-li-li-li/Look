{
  "name": "look",
  "version": "1.0.0",
  "description": "Electron desktop agent app — Look",
  "type": "module",
  "main": "dist/src/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-file-icons.mjs && patch-package",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "copy-file-icons": "node scripts/copy-file-icons.mjs",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && electron dist/src/main/index.js",
    "build": "npm run build:shared && npm run build:main && npm run build:renderer",
    "build:shared": "cd packages/shared && npm run build",
    "build:main": "rm -rf dist && tsc -p tsconfig.main.json && cp src/main/preload.js dist/src/main/preload.js && mkdir -p dist/src/main/assets && cp -f build/icon.png dist/src/main/assets/icon-1024.png",
    "build:renderer": "vite build",
    "start": "electron dist/src/main/index.js",
    "package": "npm run build && electron-builder",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "biome check src packages",
    "lint:fix": "biome check --write --unsafe src packages",
    "format": "biome format --write src packages",
    "check": "biome check src packages && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit && npm test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "^0.80.3",
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@fontsource-variable/geist": "^5.2.9",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.108.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.1",
    "jotai": "^2.20.0",
    "jotai-family": "^1.0.2",
    "lucide-react": "^1.17.0",
    "markstream-react": "^0.0.53",
    "mermaid": "^11.0.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-virtuoso": "^4.18.7",
    "recharts": "^3.9.2",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "stream-markdown": "^0.0.16",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@look/core": "*",
    "@look/shared": "*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "material-icon-theme": "^5.36.1",
    "patch-package": "^8.0.1",
    "react-scan": "^1.2.0",
    "shadcn": "^4.10.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
