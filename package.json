{
  "name": "look",
  "version": "1.0.0",
  "description": "Electron desktop agent app — Look",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && electron dist/main/index.js",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && cp src/main/preload.js dist/main/preload.js && mkdir -p dist/main/assets && cp -f src/main/assets/*.png dist/main/assets/",
    "build:renderer": "vite build",
    "start": "electron dist/main/index.js",
    "package": "npm run build && electron-builder",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write --unsafe src",
    "format": "biome format --write src",
    "check": "biome check src && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.79.1",
    "@earendil-works/pi-ai": "^0.79.1",
    "@earendil-works/pi-coding-agent": "^0.79.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@supabase/supabase-js": "^2.108.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.1",
    "jotai": "^2.20.0",
    "jotai-family": "^1.0.2",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.10.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "stats.js": "^0.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.0.0",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "react-scan": "^0.5.7",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
