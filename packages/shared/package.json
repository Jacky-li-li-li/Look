{
  "name": "@look/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared types, storage helpers, and domain contracts for Look",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "default": "./dist/contracts/*.js"
    },
    "./look-storage": {
      "types": "./dist/look-storage.d.ts",
      "default": "./dist/look-storage.js"
    },
    "./session-defaults": {
      "types": "./dist/session-defaults.d.ts",
      "default": "./dist/session-defaults.js"
    },
    "./secret-mask": {
      "types": "./dist/secret-mask.d.ts",
      "default": "./dist/secret-mask.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
